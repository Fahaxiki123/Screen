<Window x:Class="Screen.App.RecordingPreviewWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Screen.App"
        Title="编辑录屏" MinWidth="720" MinHeight="480" WindowStyle="None"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        FontFamily="{DynamicResource FontFamily.Body}" Background="{DynamicResource Brush.Window}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="5" GlassFrameThickness="0"
                      CornerRadius="{DynamicResource Radius.Bar}" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="PreviewAction" TargetType="Button" BasedOn="{StaticResource HudIconButtonStyle}">
            <Setter Property="Width" Value="64" />
            <Setter Property="Background" Value="{DynamicResource Brush.Group}" />
            <Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PreviewCaption" TargetType="Button" BasedOn="{StaticResource HudIconButtonStyle}">
            <Setter Property="Width" Value="40" /><Setter Property="Height" Value="32" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.OverlayBorder}" SnapsToDevicePixels="True">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="{DynamicResource Radius.Bar}" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0" /><Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Margin="16,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Label}" IsHitTestVisible="False" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button Style="{StaticResource PreviewCaption}" ToolTip="最小化" AutomationProperties.Name="最小化" Click="MinimizeClick">
                        <local:LucideIconElement Kind="Minus" Width="15" Height="15" Stroke="{DynamicResource Brush.OverlayIcon}"/>
                    </Button>
                    <Button Style="{StaticResource PreviewCaption}" ToolTip="最大化 / 还原" AutomationProperties.Name="最大化或还原" Click="MaximizeClick">
                        <local:LucideIconElement Kind="Square" Width="14" Height="14" Stroke="{DynamicResource Brush.OverlayIcon}"/>
                    </Button>
                    <Button Style="{StaticResource PreviewCaption}" ToolTip="关闭" AutomationProperties.Name="关闭" Click="CloseClick">
                        <local:LucideIconElement Kind="X" Width="16" Height="16" Stroke="{DynamicResource Brush.OverlayIcon}"/>
                    </Button>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" x:Name="_videoHost" Background="{DynamicResource Brush.Black}">
                <Image x:Name="_videoImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Row="2" Margin="14,10,14,8">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="裁剪" Margin="0,0,10,0" Foreground="{DynamicResource Brush.LabelSecondary}" FontSize="12" VerticalAlignment="Center" />
                    <Border Grid.Column="1" BorderThickness="1" BorderBrush="{DynamicResource Brush.Separator}"
                            Background="{DynamicResource Brush.Neutral100}" CornerRadius="{DynamicResource Radius.Control}">
                        <local:TimelineBar x:Name="_timeline" Height="28" AutomationProperties.Name="播放进度与裁剪范围"
                                           ToolTip="拖动进度定位，拖动两端手柄裁剪录屏" />
                    </Border>
                </Grid>
                <Grid Height="40">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{DynamicResource HudIconButtonStyle}" ToolTip="播放 / 暂停　Space" AutomationProperties.Name="播放或暂停" Click="PlayClick">
                            <local:LucideIconElement x:Name="_playIcon" Kind="Play" Width="18" Height="18" Stroke="{DynamicResource Brush.OverlayIcon}" />
                        </Button>
                        <TextBlock x:Name="_timeText" Text="00:00:00 / 00:00:00" Margin="8,0,12,0" VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular" FontSize="13" Foreground="{DynamicResource Brush.LabelSecondary}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="_statusText" VerticalAlignment="Center" Margin="4,0,10,0" FontSize="12"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               Foreground="{DynamicResource Brush.LabelSecondary}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="_moreButton" ToolTip="更多播放选项" AutomationProperties.Name="更多播放选项" Content="⋯"
                                FontSize="20" Style="{DynamicResource HudIconButtonStyle}" Margin="0,0,6,0" Click="PlaybackOptionsClick" />
                        <Button x:Name="_cancelExportButton" Visibility="Collapsed" Margin="0,0,6,0" Width="76" Content="取消导出"
                                Style="{StaticResource PreviewAction}" Click="CancelExportClick"/>
                        <Button x:Name="_copyButton" Style="{StaticResource PreviewAction}" Content="拷贝" IsEnabled="False" ToolTip="拷贝文件到剪贴板" Click="CopyToClipboardAsync"/>
                        <Button x:Name="_downloadButton" Style="{StaticResource PreviewAction}" Content="存储" IsEnabled="False" ToolTip="另存为文件" Margin="6,0,0,0" Click="SaveAsAsync"/>
                    </StackPanel>
                </Grid>
                <Popup x:Name="_options" PlacementTarget="{Binding ElementName=_moreButton}" Placement="Top" VerticalOffset="-4"
                       AllowsTransparency="True" StaysOpen="False">
                    <local:GlassPanel Variant="DarkSolid" CornerRadius="{DynamicResource Radius.Menu}" Padding="12" Margin="8" Width="252">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,9">
                                <TextBlock Text="倍速" VerticalAlignment="Center" FontSize="13" Margin="0,0,10,0" Foreground="{DynamicResource Brush.Label}"/>
                                <local:SegmentedControl x:Name="_speedChoices" Height="28" AutomationProperties.Name="播放倍速" />
                            </DockPanel>
                            <DockPanel>
                                <Button x:Name="_muteButton" Style="{DynamicResource HudIconButtonStyle}" Width="30" Height="28" ToolTip="静音"
                                        AutomationProperties.Name="静音或恢复声音" Click="MuteClick">
                                    <local:LucideIconElement x:Name="_volumeIcon" Kind="Volume2" Width="16" Height="16" Stroke="{DynamicResource Brush.OverlayIcon}"/>
                                </Button>
                                <Slider x:Name="_volumeSlider" Minimum="0" Maximum="1" Value="1" VerticalAlignment="Center" Margin="7,0,0,0"
                                        IsMoveToPointEnabled="True" SmallChange="0.01" LargeChange="0.1" AutomationProperties.Name="播放音量" ToolTip="播放音量"/>
                            </DockPanel>
                        </StackPanel>
                    </local:GlassPanel>
                </Popup>
            </StackPanel>
        </Grid>
    </Border>
</Window>
