<Window x:Class="Screen.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        xmlns:ui="clr-namespace:Screen.App"
        Title="Flick 设置" Width="860" Height="568" MinWidth="760" MinHeight="480"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" FontSize="13.5" Foreground="#111827"
        Background="Transparent" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Closed="OnClosed">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="19,15,19,23" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Settings.Brush.TextPrimary" Color="#111827" />
        <SolidColorBrush x:Key="Settings.Brush.TextSecondary" Color="#6B7280" />
        <SolidColorBrush x:Key="Settings.Brush.TextTertiary" Color="#8A94A6" />
        <SolidColorBrush x:Key="Settings.Brush.Accent" Color="#007AFF" />
        <SolidColorBrush x:Key="Settings.Brush.AccentText" Color="#007AFF" />
        <SolidColorBrush x:Key="Settings.Brush.NavText" Color="#4B5563" />
        <SolidColorBrush x:Key="Settings.Brush.NavIcon" Color="#64748B" />
        <SolidColorBrush x:Key="Settings.Brush.NavHover" Color="#0D0F172A" />
        <SolidColorBrush x:Key="Settings.Brush.Divider" Color="#0E0F172A" />
        <SolidColorBrush x:Key="Settings.Brush.ControlBackground" Color="#F1F4F8" />
        <SolidColorBrush x:Key="Settings.Brush.ControlBackgroundSubtle" Color="#F1F4F8" />
        <SolidColorBrush x:Key="Settings.Brush.ControlBackgroundHover" Color="#E8EDF4" />
        <SolidColorBrush x:Key="Settings.Brush.ControlBorder" Color="#100F172A" />
        <SolidColorBrush x:Key="Settings.Brush.Selection" Color="#33007AFF" />
        <SolidColorBrush x:Key="Settings.Brush.Success" Color="#15803D" />
        <SolidColorBrush x:Key="Settings.Brush.Error" Color="#C22B24" />
        <sys:Double x:Key="Settings.ControlHeight">32</sys:Double>
        <sys:Double x:Key="Settings.FontSize.SettingTitle">13.5</sys:Double>
        <sys:Double x:Key="Settings.FontSize.SettingDescription">12</sys:Double>
        <sys:Double x:Key="Settings.FontSize.Control">12.5</sys:Double>
        <sys:Double x:Key="Settings.FontSize.Section">11.5</sys:Double>
        <sys:Double x:Key="Settings.FontSize.Keycap">12</sys:Double>
        <FontWeight x:Key="Settings.FontWeight.SettingTitle">SemiBold</FontWeight>
        <FontWeight x:Key="Settings.FontWeight.SettingDescription">Normal</FontWeight>
        <FontWeight x:Key="Settings.FontWeight.Section">Medium</FontWeight>
        <FontWeight x:Key="Settings.FontWeight.Keycap">SemiBold</FontWeight>
        <Thickness x:Key="Settings.Spacing.RowPadding">16,13</Thickness>
        <Thickness x:Key="Settings.Spacing.SectionHeaderPadding">2,0,0,7</Thickness>
        <CornerRadius x:Key="Settings.CornerRadius.Control">6.5</CornerRadius>
        <Style x:Key="SettingsFocusVisualStyle" TargetType="Control" BasedOn="{StaticResource ThemeFocusVisualStyle}" />
        <Style x:Key="SettingsToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource AppleSwitchStyle}" />
        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}" />
        <Style x:Key="SettingsPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource CardPrimaryButtonStyle}" />

        <Style x:Key="SettingsSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Background" Value="#EEF2F7" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ui:SquircleGlassBorder x:Name="Body" CornerRadiusRadius="6.5" ShowRim="False" ShadowLevel="0"
                                                GlassBackground="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <ui:SquircleGlassBorder.RenderTransform>
                                <ScaleTransform />
                            </ui:SquircleGlassBorder.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </ui:SquircleGlassBorder>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="GlassBackground" Value="#E4EAF2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Body" Property="GlassBackground" Value="#DCE4EE" />
                                <Setter TargetName="Body" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.988" ScaleY="0.988" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsHotKeyButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsSecondaryButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="3" />
        </Style>

        <Style x:Key="SettingsKeycapStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="5.5" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="BorderBrush" Value="#1A0F172A" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- 悬停淡灰磁吸与白色选中卡片由 SettingsNavGroup 统一驱动，避免双重底色与切换闪烁 -->
        <Style x:Key="SettingsNavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Settings.Brush.NavText}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavSurface" Background="Transparent" CornerRadius="8.5"
                                Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavSurface" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.988" ScaleY="0.988" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ TextBox ============ -->
        <Style x:Key="SettingsTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="{StaticResource Settings.ControlHeight}" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{StaticResource Settings.Brush.ControlBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Settings.Brush.ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Settings.Brush.TextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource Settings.Brush.AccentText}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Settings.Brush.Selection}" />
            <Setter Property="SelectionOpacity" Value="1" />
            <Setter Property="FontSize" Value="{StaticResource Settings.FontSize.Control}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Settings.CornerRadius.Control}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Settings.Brush.ControlBackgroundHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Settings.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ PasswordBox ============ -->
        <Style x:Key="SettingsPasswordBoxStyle" TargetType="{x:Type PasswordBox}">
            <Setter Property="Height" Value="{StaticResource Settings.ControlHeight}" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{StaticResource Settings.Brush.ControlBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Settings.Brush.ControlBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Settings.Brush.TextPrimary}" />
            <Setter Property="CaretBrush" Value="{StaticResource Settings.Brush.AccentText}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Settings.Brush.Selection}" />
            <Setter Property="SelectionOpacity" Value="1" />
            <Setter Property="FontSize" Value="{StaticResource Settings.FontSize.Control}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Settings.CornerRadius.Control}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Settings.Brush.ControlBackgroundHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Settings.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsWindowControlStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#0F0F172A" />
                                <Setter Property="Foreground" Value="#111827" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1C0F172A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsThinScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Margin" Value="0,6,4,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Pill" Width="5" HorizontalAlignment="Center"
                                                        CornerRadius="2.5" Background="#220F172A" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Pill" Property="Background" Value="#3D0F172A" />
                                                        <Setter TargetName="Pill" Property="Width" Value="6" />
                                                        <Setter TargetName="Pill" Property="CornerRadius" Value="3" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Pill" Property="Background" Value="#540F172A" />
                                                        <Setter TargetName="Pill" Property="Width" Value="6" />
                                                        <Setter TargetName="Pill" Property="CornerRadius" Value="3" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsThinScrollBarStyle}" />

        <Style x:Key="SettingsWindowCloseStyle" TargetType="Button" BasedOn="{StaticResource SettingsWindowControlStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1FEF4444" />
                                <Setter Property="Foreground" Value="#DC2626" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#33EF4444" />
                                <Setter Property="Foreground" Value="#B91C1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 方案 A：无缝两栏结构，取消右侧悬浮大卡片与重阴影套娃 -->
    <ui:SquircleGlassBorder x:Name="WindowFrame" CornerRadiusRadius="13" ShowRim="False"
                            OutlineBrush="#180F172A" OutlineThickness="1"
                            ShadowLevel="3" CacheShadows="True" Padding="0"
                            Margin="16,12,16,20" GlassBackground="#F9FAFC">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧无缝导航栏 -->
            <Border Grid.Column="0" Background="#F2F4F8" BorderBrush="#110F172A" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 品牌头部（可拖动整个窗口） -->
                    <StackPanel Orientation="Horizontal" Background="Transparent" MouseLeftButtonDown="DragTitleBar"
                                Margin="18,15,12,15">
                        <Image Width="28" Height="28"
                               Source="pack://application:,,,/Screen;component/Assets/Screen.png"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center" />
                        <TextBlock Text="Flick" Margin="9,0,6,0" FontSize="15" FontWeight="SemiBold"
                                   Foreground="#111827" VerticalAlignment="Center" />
                        <TextBlock Text="设置" FontSize="12" Foreground="#7B8494" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 分组导航轨道（每组独立白卡平移 + 跨组淡切 + 淡灰悬停磁吸） -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel x:Name="NavGroupsHost" Margin="12,0,12,12" />
                    </ScrollViewer>

                    <!-- 底部静默状态条（与右侧底栏同基线对齐） -->
                    <Border Grid.Row="2" BorderBrush="#0F0F172A" BorderThickness="0,1,0,0" Margin="12,0,12,0" Padding="8,10,8,12">
                        <DockPanel>
                            <TextBlock x:Name="NavVersion" DockPanel.Dock="Right" FontSize="11"
                                       FontFamily="{DynamicResource Font.Numeric}" Foreground="#94A3B8" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="EngineDot" Width="6" Height="6" Margin="0,0,6,0" Fill="{DynamicResource Brush.Success}" />
                                <TextBlock x:Name="EngineStatus" FontSize="11.5" Foreground="#64748B" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 右侧无缝主内容区（直达窗边，归位主窗口控制按钮） -->
            <Grid Grid.Column="1" Background="#F9FAFC">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 一体化顶栏：左置当前页标题，右置窗口级最小化/关闭 -->
                <DockPanel Margin="28,14,14,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Width="28" MinWidth="28" Height="28" Style="{StaticResource SettingsWindowControlStyle}"
                                ToolTip="最小化" AutomationProperties.Name="最小化" Click="MinimizeWindow">
                            <ui:LucideIconElement Kind="Minus" Width="15" Height="15" />
                        </Button>
                        <Button Width="28" MinWidth="28" Height="28" Margin="4,0,0,0" Style="{StaticResource SettingsWindowCloseStyle}"
                                ToolTip="关闭" AutomationProperties.Name="关闭" Click="CloseWindow">
                            <ui:LucideIconElement Kind="X" Width="15" Height="15" />
                        </Button>
                    </StackPanel>
                    <Grid Background="Transparent" MouseLeftButtonDown="DragTitleBar">
                        <TextBlock x:Name="PageTitle" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="#111827" />
                    </Grid>
                </DockPanel>

                <!-- 主滚动内容区 -->
                <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="28,0,24,20" MaxWidth="680">
                        <TextBlock x:Name="PageDescription" Margin="0,0,0,18" FontSize="12.5" Foreground="#6B7280" TextWrapping="Wrap" />
                        <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" Focusable="False" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 底部状态提示（与左侧状态条完全同平面同基线） -->
                <Border Grid.Row="2" BorderBrush="#0F0F172A" BorderThickness="0,1,0,0" Margin="28,0,28,0" Padding="0,10,0,12">
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" HorizontalAlignment="Right" FontSize="11.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#7B8494" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Foreground" Value="#C22B24" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </Grid>
    </ui:SquircleGlassBorder>
</Window>
