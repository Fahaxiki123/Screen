<Window x:Class="Screen.App.RecordingControlWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Screen.App"
        Title="Screen 录屏" WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" AllowsTransparency="True" Background="{DynamicResource Brush.Transparent}"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True">
    <local:GlassPanel Variant="Solid" Padding="8,4,4,4" Margin="10,5,10,12">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="16" Height="18" Margin="0,0,5,0">
                <!-- Empty background shapes carry the glow, never the timer or labels. -->
                <Ellipse x:Name="_beaconHalo" Width="9" Height="9" Fill="{DynamicResource Brush.Record}" Effect="{DynamicResource Recording.BeaconGlow}"/>
                <Ellipse x:Name="_beacon" Width="9" Height="9" Fill="{DynamicResource Recording.Beacon}"/>
            </Grid>
            <TextBlock x:Name="_timer" Text="00:00" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Typography.NumeralAlignment="Tabular"/>
            <Border Background="{DynamicResource Recording.BadgeFill}" CornerRadius="{DynamicResource Radius.Key}" VerticalAlignment="Center"
                    Margin="8,0,6,0" Padding="5,2">
                <TextBlock x:Name="_format" FontSize="11" FontWeight="SemiBold" />
            </Border>
            <TextBlock x:Name="_statusLabel" MaxWidth="240" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"
                       FontSize="12" VerticalAlignment="Center" Visibility="Collapsed"/>
            <StackPanel x:Name="_meterHost" Orientation="Horizontal" Height="16" Margin="3,0,6,0" VerticalAlignment="Center" ToolTip="实时音频电平"/>
            <Button x:Name="_pauseButton" Style="{DynamicResource HudIconButtonStyle}" Width="30" Height="30" MinWidth="30"
                    ToolTip="暂停录制" AutomationProperties.Name="暂停录制" Click="PauseClick">
                <local:LucideIconElement x:Name="_pauseIcon" Kind="Pause" Width="15" Height="15" StrokeThickness="1.8" Stroke="{DynamicResource Brush.Label}"/>
            </Button>
            <Button x:Name="_stopButton" Style="{DynamicResource Recording.Stop}" ToolTip="结束录制并打开预览 (Esc)"
                    AutomationProperties.Name="结束录制" Click="StopClick">
                <StackPanel Orientation="Horizontal">
                    <Rectangle Width="9" Height="9" Fill="{DynamicResource Brush.White}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="_stopLabel" Text="取消保存" Margin="6,0,0,0" Visibility="Collapsed" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </local:GlassPanel>
</Window>
