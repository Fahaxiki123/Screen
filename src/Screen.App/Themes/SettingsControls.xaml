<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Screen.App">
    <LinearGradientBrush x:Key="Brush.SegmentThumb" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#42FFFFFF" Offset="0"/>
        <GradientStop Color="#26FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.SwitchThumb" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="White" Offset="0"/>
        <GradientStop Color="#FFE6E6EB" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Keycap" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4D4D52" Offset="0"/>
        <GradientStop Color="#3A3A3C" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="SegmentItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.LabelSecondary}"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Control}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Label}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Brush.AccentText}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type local:SegmentedControl}">
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Background" Value="#38000000"/>
        <Setter Property="BorderBrush" Value="#40000000"/>
        <Setter Property="FontFamily" Value="{DynamicResource FontFamily.Body}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font.Body}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentItemStyle}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SegmentedControl}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0,1,0,0" Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource Radius.Button}">
                        <Grid x:Name="PART_Track">
                            <Border x:Name="PART_Indicator" IsHitTestVisible="False" Visibility="Hidden"
                                    Width="0" HorizontalAlignment="Left" Background="{StaticResource Brush.SegmentThumb}"
                                    BorderBrush="{DynamicResource Brush.GlassRim}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Control}">
                                <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                            </Border>
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <BackEase x:Key="SwitchEase" EasingMode="EaseOut" Amplitude="0.3"/>
    <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
        <Setter Property="local:SwitchMotion.Enabled" Value="True"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="MinWidth" Value="40"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border CornerRadius="12" Background="#47000000" BorderThickness="1" BorderBrush="{DynamicResource Brush.Separator}"/>
                        <Border x:Name="ColorTrack" CornerRadius="12" Opacity="0"
                                Background="{DynamicResource Brush.PrimaryAction}" BorderThickness="1" BorderBrush="{DynamicResource Brush.GlassRim}"/>
                        <Border x:Name="Thumb" Tag="0" Width="20" Height="20" Margin="2,0,0,0" HorizontalAlignment="Left"
                                CornerRadius="10" Background="{StaticResource Brush.SwitchThumb}">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ThumbStretch"/>
                                    <TranslateTransform x:Name="ThumbMove" X="{Binding Tag, ElementName=Thumb}"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="SwitchFocus" Visibility="Hidden" BorderThickness="1" BorderBrush="{DynamicResource Brush.AccentText}" CornerRadius="12"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Thumb" Property="RenderTransformOrigin" Value="1,0.5"/>
                            <!-- Always provide the selected base state, even before the first animation tick. -->
                            <Setter TargetName="Thumb" Property="Tag" Value="16"/>
                            <Setter TargetName="ColorTrack" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ThumbStretch" Storyboard.TargetProperty="ScaleX" To="1.25" Duration="0:0:0.15"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ThumbStretch" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.35"
                                                     EasingFunction="{StaticResource SwitchEase}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwitchFocus" Property="Visibility" Value="Visible"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="KeycapStyle" TargetType="Border">
        <Setter Property="Height" Value="22"/>
        <Setter Property="MinWidth" Value="22"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Key}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.EdgeDark}"/>
        <Setter Property="Background" Value="{StaticResource Brush.Keycap}"/>
        <Setter Property="TextElement.FontSize" Value="{DynamicResource Font.Badge}"/>
        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.Label}"/>
    </Style>
    <Style x:Key="SettingsGroup" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Group}"/>
        <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
        <Setter Property="BorderThickness" Value="1,1,0,0"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Bar}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="SettingsRow" TargetType="Border">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="14,3"/>
    </Style>
    <Style x:Key="SettingsDivider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="14,0"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Separator}"/>
    </Style>
    <Style x:Key="SettingsIconDivider" TargetType="Border" BasedOn="{StaticResource SettingsDivider}">
        <Setter Property="Margin" Value="48,0,14,0"/>
    </Style>
    <Style TargetType="{x:Type local:IconTile}">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:IconTile}">
                    <Viewbox>
                        <Grid Width="100" Height="100">
                            <Border CornerRadius="24" Background="{TemplateBinding Background}"/>
                            <Border CornerRadius="24" BorderBrush="{DynamicResource Brush.GlassRim}" BorderThickness="3"/>
                            <Viewbox Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter/>
                            </Viewbox>
                        </Grid>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <LinearGradientBrush x:Key="Tile.Gray" StartPoint="0.32,0" EndPoint="0.68,1">
        <GradientStop Color="#B0B0B6" Offset="0"/>
        <GradientStop Color="#6E6E73" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Tile.Red" StartPoint="0.32,0" EndPoint="0.68,1">
        <GradientStop Color="#FF7A70" Offset="0"/>
        <GradientStop Color="#E0352B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Tile.Indigo" StartPoint="0.32,0" EndPoint="0.68,1">
        <GradientStop Color="#9D8BFF" Offset="0"/>
        <GradientStop Color="#5B48E0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Tile.Blue" StartPoint="0.32,0" EndPoint="0.68,1">
        <GradientStop Color="#5AAEFF" Offset="0"/>
        <GradientStop Color="#0A6FE0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Tile.Purple" StartPoint="0.32,0" EndPoint="0.68,1">
        <GradientStop Color="#D98BFF" Offset="0"/>
        <GradientStop Color="#9B3FE0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Tile.Pink" StartPoint="0.32,0" EndPoint="0.68,1">
        <GradientStop Color="#FF7FB0" Offset="0"/>
        <GradientStop Color="#E0356F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Tile.Orange" StartPoint="0.32,0" EndPoint="0.68,1">
        <GradientStop Color="#FFC05A" Offset="0"/>
        <GradientStop Color="#F07D00" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Tile.Teal" StartPoint="0.32,0" EndPoint="0.68,1">
        <GradientStop Color="#6FE8DC" Offset="0"/>
        <GradientStop Color="#14A99A" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
