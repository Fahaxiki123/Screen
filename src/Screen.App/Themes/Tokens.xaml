<!--
  Liquid Sapphire design tokens: deep abyssal navy surfaces, ice-cyan optics,
  and ruby recording accents.
  Rules:
  - All app chrome shares deep sapphire surfaces. Captured image/video pixels and
    annotation colors are independent from these UI resources.
  - Floating HUDs carry a top specular rim and deep ambient drop shadows.
  - Type scale 12/14/14/16/20, radius scale 4/8/12/16.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core sapphire neutrals -->
    <Color x:Key="Color.NightBlue">#0A1222</Color>
    <Color x:Key="Color.MoonBlue">#EBF4FF</Color>
    <Color x:Key="Color.Neutral50">#0E192E</Color>
    <Color x:Key="Color.Neutral100">#13223D</Color>
    <Color x:Key="Color.Neutral150">#1A2E50</Color>
    <Color x:Key="Color.Neutral200">#233C67</Color>
    <Color x:Key="Color.Neutral300">#4A6994</Color>
    <Color x:Key="Color.Neutral400">#6C8CB8</Color>
    <Color x:Key="Color.Neutral500">#94AECE</Color>
    <Color x:Key="Color.Neutral600">#BDD1EA</Color>
    <Color x:Key="Color.Neutral700">#DCE8F7</Color>
    <Color x:Key="Color.Neutral800">#EBF3FC</Color>
    <Color x:Key="Color.Neutral900">#F4F8FF</Color>

    <!-- Sunken input well (darker than card surface so inputs need no harsh outline) -->
    <Color x:Key="Color.Sunken">#080F1D</Color>

    <SolidColorBrush x:Key="Brush.WindowBackground" Color="{StaticResource Color.NightBlue}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Neutral50}" />
    <SolidColorBrush x:Key="Brush.SurfaceSunken" Color="{StaticResource Color.Sunken}" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.Neutral100}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.Neutral150}" />
    <SolidColorBrush x:Key="Brush.Border" Color="#2694C5FF" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#1894C5FF" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#7DD3FC" />

    <!-- Layered sapphire gradients & specular glass rims -->
    <LinearGradientBrush x:Key="Brush.WindowBackdrop" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#080F1E" Offset="0" />
        <GradientStop Color="#0C162B" Offset="0.55" />
        <GradientStop Color="#0A1222" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.BrandGradient" StartPoint="0,0" EndPoint="0.85,1">
        <GradientStop Color="#0D1930" Offset="0" />
        <GradientStop Color="#0B1528" Offset="0.6" />
        <GradientStop Color="#091120" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ChromeGradient" StartPoint="0,0" EndPoint="0.2,1">
        <GradientStop Color="#EB152644" Offset="0" />
        <GradientStop Color="#F20E1A30" Offset="0.5" />
        <GradientStop Color="#F60A1222" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.AuroraCard" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#F416294A" Offset="0" />
        <GradientStop Color="#F70F1C34" Offset="0.36" />
        <GradientStop Color="#FA0B1426" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.GlassRim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4CD2EAFF" Offset="0" />
        <GradientStop Color="#2294C5FF" Offset="0.4" />
        <GradientStop Color="#1494C5FF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.AccentSubtleDarkBorder" Color="#457DD3FC" />
    <LinearGradientBrush x:Key="Brush.PrimaryAction" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#38BDF8" Offset="0" />
        <GradientStop Color="#0EA5E9" Offset="0.55" />
        <GradientStop Color="#0284C7" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.PrimaryActionHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7DD3FC" Offset="0" />
        <GradientStop Color="#38BDF8" Offset="0.55" />
        <GradientStop Color="#0EA5E9" Offset="1" />
    </LinearGradientBrush>

    <!-- Ruby recording accents (replaces muddy pink) -->
    <LinearGradientBrush x:Key="Brush.RubyGlass" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#42F43F5E" Offset="0" />
        <GradientStop Color="#26E11D48" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.RubySolid" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FB7185" Offset="0" />
        <GradientStop Color="#F43F5E" Offset="0.45" />
        <GradientStop Color="#E11D48" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.RubyBorder" Color="#6BF43F5E" />
    <SolidColorBrush x:Key="Brush.RubyText" Color="#FFE4E8" />

    <!-- ****** Semantic palette ****** -->
    <Color x:Key="Color.Accent">#38BDF8</Color>
    <Color x:Key="Color.AccentHover">#7DD3FC</Color>
    <Color x:Key="Color.AccentSubtle">#173254</Color>
    <Color x:Key="Color.AccentSubtleHover">#1F426E</Color>
    <Color x:Key="Color.AccentOnDark">#FFFFFF</Color>
    <Color x:Key="Color.AccentSubtleDark">#3338BDF8</Color>
    <Color x:Key="Color.AccentSubtleDarkHover">#4D38BDF8</Color>
    <Color x:Key="Color.Success">#34D399</Color>
    <Color x:Key="Color.SuccessOnDark">#34D399</Color>
    <Color x:Key="Color.Danger">#F43F5E</Color>
    <Color x:Key="Color.DangerOnDark">#FB7185</Color>
    <Color x:Key="Color.Warning">#FBBF24</Color>

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.Neutral900}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.Neutral500}" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.Neutral400}" />

    <!-- ****** Sapphire overlay chrome ****** -->
    <SolidColorBrush x:Key="Brush.OverlayBase" Color="#E60C162A" />
    <SolidColorBrush x:Key="Brush.OverlayElevated" Color="#F2111F38" />
    <SolidColorBrush x:Key="Brush.OverlayHover" Color="#247DD3FC" />
    <SolidColorBrush x:Key="Brush.OverlayPressed" Color="#387DD3FC" />
    <SolidColorBrush x:Key="Brush.OverlayBorder" Color="#2E94C5FF" />
    <SolidColorBrush x:Key="Brush.OverlayText" Color="#F4F8FF" />
    <SolidColorBrush x:Key="Brush.OverlayTextDim" Color="#94AECE" />
    <SolidColorBrush x:Key="Brush.OverlayIcon" Color="#E2EEFC" />

    <!-- ****** Brushes (named colors) ****** -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#38BDF8" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#7DD3FC" />
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#2638BDF8" />
    <SolidColorBrush x:Key="Brush.AccentSubtleHover" Color="#3838BDF8" />
    <SolidColorBrush x:Key="Brush.AccentOnDark" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.AccentSubtleDark" Color="#2E38BDF8" />
    <SolidColorBrush x:Key="Brush.AccentSubtleDarkHover" Color="#4538BDF8" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessOnDark" Color="{StaticResource Color.SuccessOnDark}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerOnDark" Color="{StaticResource Color.DangerOnDark}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Neutral50" Color="{StaticResource Color.Neutral50}" />
    <SolidColorBrush x:Key="Brush.Neutral100" Color="{StaticResource Color.Neutral100}" />
    <SolidColorBrush x:Key="Brush.Neutral150" Color="{StaticResource Color.Neutral150}" />
    <SolidColorBrush x:Key="Brush.Neutral200" Color="{StaticResource Color.Neutral200}" />
    <SolidColorBrush x:Key="Brush.Neutral300" Color="{StaticResource Color.Neutral300}" />
    <SolidColorBrush x:Key="Brush.Neutral400" Color="{StaticResource Color.Neutral400}" />
    <SolidColorBrush x:Key="Brush.Neutral500" Color="{StaticResource Color.Neutral500}" />
    <SolidColorBrush x:Key="Brush.Neutral600" Color="{StaticResource Color.Neutral600}" />
    <SolidColorBrush x:Key="Brush.Neutral700" Color="{StaticResource Color.Neutral700}" />

    <!-- ****** Type scale (Segoe UI Variable + Microsoft YaHei UI fallback) ****** -->
    <system:Double x:Key="Font.Caption" xmlns:system="clr-namespace:System;assembly=mscorlib">12</system:Double>
    <system:Double x:Key="Font.Body" xmlns:system="clr-namespace:System;assembly=mscorlib">14</system:Double>
    <system:Double x:Key="Font.Subtitle" xmlns:system="clr-namespace:System;assembly=mscorlib">14</system:Double>
    <system:Double x:Key="Font.Title" xmlns:system="clr-namespace:System;assembly=mscorlib">16</system:Double>
    <system:Double x:Key="Font.Display" xmlns:system="clr-namespace:System;assembly=mscorlib">20</system:Double>

    <!-- Radius scale -->
    <CornerRadius x:Key="Radius.Small">4</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">8</CornerRadius>
    <CornerRadius x:Key="Radius.Control">8</CornerRadius>
    <CornerRadius x:Key="Radius.Large">12</CornerRadius>
    <CornerRadius x:Key="Radius.SubCard">12</CornerRadius>
    <CornerRadius x:Key="Radius.Bar">14</CornerRadius>
    <CornerRadius x:Key="Radius.XLarge">16</CornerRadius>
    <CornerRadius x:Key="Radius.Card">16</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">99</CornerRadius>

    <!-- Elevation: deep abyssal shadows -->
    <DropShadowEffect x:Key="Shadow.Hover" BlurRadius="12" ShadowDepth="2" Opacity="0.28" Color="#020610" />
    <DropShadowEffect x:Key="Shadow.Floating" BlurRadius="32" ShadowDepth="10" Opacity="0.58" Color="#020610" />
    <DropShadowEffect x:Key="Shadow.Modal" BlurRadius="52" ShadowDepth="18" Opacity="0.72" Color="#020610" />
</ResourceDictionary>
