<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.NightBlue">#F4F6F9</Color>
    <Color x:Key="Color.MoonBlue">#FAFBFD</Color>
    <Color x:Key="Color.Neutral50">#FAFBFD</Color>
    <Color x:Key="Color.Neutral100">#F3F5F8</Color>
    <Color x:Key="Color.Neutral150">#EAEFF5</Color>
    <Color x:Key="Color.Neutral200">#DEE3EA</Color>
    <Color x:Key="Color.Neutral300">#A6AFBD</Color>
    <Color x:Key="Color.Neutral400">#6B1D1D1F</Color>
    <Color x:Key="Color.Neutral500">#9E1D1D1F</Color>
    <Color x:Key="Color.Neutral600">#525C6B</Color>
    <Color x:Key="Color.Neutral700">#343A44</Color>
    <Color x:Key="Color.Neutral800">#23272D</Color>
    <Color x:Key="Color.Neutral900">#1D1D1F</Color>

    <Color x:Key="Color.Sunken">#0E0F172A</Color>

    <FontFamily x:Key="Font.UI">Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Font.Numeric">Cascadia Mono, Consolas</FontFamily>
    <SolidColorBrush x:Key="Brush.SelectionMask" Color="#570F172A" />
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="{StaticResource Color.NightBlue}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Neutral50}" />
    <SolidColorBrush x:Key="Brush.SurfaceSunken" Color="{StaticResource Color.Sunken}" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.Neutral100}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#0E0F172A" />
    <SolidColorBrush x:Key="Brush.Border" Color="#210F172A" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#1A0F172A" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#007AFF" />

    <LinearGradientBrush x:Key="Brush.WindowBackdrop" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF4F6F9" Offset="0" />
        <GradientStop Color="#FFEEF1F5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.BrandGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF1888FF" Offset="0" />
        <GradientStop Color="#FF007AFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ChromeGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D9FFFFFF" Offset="0" />
        <GradientStop Color="#C4F6F8FC" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.AuroraCard" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EBFFFFFF" Offset="0" />
        <GradientStop Color="#D9F8FAFD" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.GlassRim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F5FFFFFF" Offset="0" />
        <GradientStop Color="#73FFFFFF" Offset="0.45" />
        <GradientStop Color="#2EFFFFFF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.AccentSubtleDarkBorder" Color="#38007AFF" />
    <LinearGradientBrush x:Key="Brush.PrimaryAction" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF1888FF" Offset="0" />
        <GradientStop Color="#FF007AFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.PrimaryActionHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF3897FF" Offset="0" />
        <GradientStop Color="#FF187FFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.RubyGlass" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#24FF3B30" Offset="0" />
        <GradientStop Color="#24FF3B30" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.RubySolid" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFF574E" Offset="0" />
        <GradientStop Color="#FFFF3B30" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.RubyBorder" Color="#57FF3B30" />
    <SolidColorBrush x:Key="Brush.RubyText" Color="#FF3B30" />

    <Color x:Key="Color.Accent">#007AFF</Color>
    <Color x:Key="Color.AccentHover">#1888FF</Color>
    <Color x:Key="Color.AccentSubtle">#1C007AFF</Color>
    <Color x:Key="Color.AccentSubtleHover">#29007AFF</Color>
    <Color x:Key="Color.AccentOnDark">#FFFFFF</Color>
    <Color x:Key="Color.AccentSubtleDark">#1C007AFF</Color>
    <Color x:Key="Color.AccentSubtleDarkHover">#29007AFF</Color>
    <Color x:Key="Color.Success">#28CD41</Color>
    <Color x:Key="Color.SuccessOnDark">#28CD41</Color>
    <Color x:Key="Color.Danger">#FF3B30</Color>
    <Color x:Key="Color.DangerOnDark">#FF3B30</Color>
    <Color x:Key="Color.Warning">#FF9F0A</Color>

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.Neutral900}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.Neutral500}" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.Neutral400}" />

    <SolidColorBrush x:Key="Brush.OverlayBase" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="Brush.OverlayElevated" Color="#EBFFFFFF" />
    <SolidColorBrush x:Key="Brush.OverlayHover" Color="#0E0F172A" />
    <SolidColorBrush x:Key="Brush.OverlayPressed" Color="#1F0F172A" />
    <SolidColorBrush x:Key="Brush.OverlayBorder" Color="#210F172A" />
    <SolidColorBrush x:Key="Brush.OverlayText" Color="#1D1D1F" />
    <SolidColorBrush x:Key="Brush.OverlayTextDim" Color="#9E1D1D1F" />
    <SolidColorBrush x:Key="Brush.OverlayIcon" Color="#1D1D1F" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#007AFF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#1888FF" />
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#1C007AFF" />
    <SolidColorBrush x:Key="Brush.AccentSubtleHover" Color="#29007AFF" />
    <SolidColorBrush x:Key="Brush.AccentOnDark" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.AccentSubtleDark" Color="#1C007AFF" />
    <SolidColorBrush x:Key="Brush.AccentSubtleDarkHover" Color="#29007AFF" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessOnDark" Color="{StaticResource Color.SuccessOnDark}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerOnDark" Color="{StaticResource Color.DangerOnDark}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Neutral50" Color="{StaticResource Color.Neutral50}" />
    <SolidColorBrush x:Key="Brush.Neutral100" Color="{StaticResource Color.Neutral100}" />
    <SolidColorBrush x:Key="Brush.Neutral150" Color="{StaticResource Color.Neutral150}" />
    <SolidColorBrush x:Key="Brush.Neutral200" Color="{StaticResource Color.Neutral200}" />
    <SolidColorBrush x:Key="Brush.Neutral300" Color="{StaticResource Color.Neutral300}" />
    <SolidColorBrush x:Key="Brush.Neutral400" Color="{StaticResource Color.Neutral400}" />
    <SolidColorBrush x:Key="Brush.Neutral500" Color="{StaticResource Color.Neutral500}" />
    <SolidColorBrush x:Key="Brush.Neutral600" Color="{StaticResource Color.Neutral600}" />
    <SolidColorBrush x:Key="Brush.Neutral700" Color="{StaticResource Color.Neutral700}" />

    <system:Double x:Key="Font.Caption" xmlns:system="clr-namespace:System;assembly=mscorlib">12</system:Double>
    <system:Double x:Key="Font.Body" xmlns:system="clr-namespace:System;assembly=mscorlib">14</system:Double>
    <system:Double x:Key="Font.Subtitle" xmlns:system="clr-namespace:System;assembly=mscorlib">14</system:Double>
    <system:Double x:Key="Font.Title" xmlns:system="clr-namespace:System;assembly=mscorlib">16</system:Double>
    <system:Double x:Key="Font.Display" xmlns:system="clr-namespace:System;assembly=mscorlib">20</system:Double>

    <CornerRadius x:Key="Radius.Small">4.5</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">6.5</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6.5</CornerRadius>
    <CornerRadius x:Key="Radius.Large">11</CornerRadius>
    <CornerRadius x:Key="Radius.SubCard">9.5</CornerRadius>
    <CornerRadius x:Key="Radius.Bar">10.5</CornerRadius>
    <CornerRadius x:Key="Radius.XLarge">13</CornerRadius>
    <CornerRadius x:Key="Radius.Card">13</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">99</CornerRadius>

    <DropShadowEffect x:Key="Shadow.Hover" BlurRadius="6" ShadowDepth="1" Opacity="0.12" Color="#0F172A" />
    <DropShadowEffect x:Key="Shadow.Floating" BlurRadius="18" ShadowDepth="4" Opacity="0.15" Color="#0F172A" />
    <DropShadowEffect x:Key="Shadow.Modal" BlurRadius="24" ShadowDepth="6" Opacity="0.18" Color="#0F172A" />
    <LinearGradientBrush x:Key="Brush.LiquidSlider" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FAFFFFFF" Offset="0" />
        <GradientStop Color="#E8F7F9FC" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
