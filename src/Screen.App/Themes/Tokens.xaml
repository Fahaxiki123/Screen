<!-- Screen v4: neutral glass chrome. Capture pixels and user annotations are independent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Color x:Key="Color.Accent">#0A84FF</Color>
    <Color x:Key="Color.AccentTop">#3D9BFF</Color>
    <Color x:Key="Color.AccentBottom">#0A7AEE</Color>
    <Color x:Key="Color.Record">#FF453A</Color>
    <Color x:Key="Color.RecordTop">#FF6259</Color>
    <Color x:Key="Color.RecordBottom">#E8352B</Color>
    <Color x:Key="Color.Success">#32D74B</Color>
    <Color x:Key="Color.Warning">#FFD60A</Color>
    <Color x:Key="Color.Label">#F5F5F7</Color>
    <Color x:Key="Color.LabelSecondary">#99EBEBF5</Color>
    <Color x:Key="Color.LabelTertiary">#4DEBEBF5</Color>
    <Color x:Key="Color.GlassTintTop">#853C3C42</Color>
    <Color x:Key="Color.GlassTintBottom">#99262C2C</Color>
    <Color x:Key="Color.GlassWhite">#0DFFFFFF</Color>
    <Color x:Key="Color.GlassSolid">#EB26262A</Color>
    <Color x:Key="Color.DarkGlassSolid">#F21C1C20</Color>
    <Color x:Key="Color.Window">#1E1E20</Color>
    <Color x:Key="Color.Group">#0FFFFFFF</Color>
    <Color x:Key="Color.Separator">#1AFFFFFF</Color>
    <Color x:Key="Color.Hover">#12FFFFFF</Color>
    <Color x:Key="Color.Pressed">#1FFFFFFF</Color>
    <Color x:Key="Color.Selected">#29FFFFFF</Color>
    <Color x:Key="Color.EdgeHighlight">#42FFFFFF</Color>
    <Color x:Key="Color.EdgeFade">#0AFFFFFF</Color>
    <Color x:Key="Color.EdgeDark">#80000000</Color>
    <Color x:Key="Color.AccentText">#6CB4FF</Color>
    <Color x:Key="Color.AccentSubtleDark">#6B0A84FF</Color>
    <Color x:Key="Color.AccentSubtle">#260A84FF</Color>
    <Color x:Key="Color.AccentSubtleHover">#380A84FF</Color>
    <Color x:Key="Color.White">#FFFFFF</Color>
    <Color x:Key="Color.Black">#000000</Color>
    <Color x:Key="Color.Transparent">#00000000</Color>
    <Color x:Key="Color.Sunken">#18181A</Color>
    <Color x:Key="Color.RecordBorder">#6BFF453A</Color>
    <Color x:Key="Color.RecordGlassTop">#42FF453A</Color>
    <Color x:Key="Color.RecordGlassBottom">#26FF453A</Color>
    <Color x:Key="Color.Dim">#6B000000</Color>
    <Color x:Key="Color.RimBlue">#660A84FF</Color>
    <Color x:Key="Color.Neutral50">#1C1C1E</Color>
    <Color x:Key="Color.Neutral100">#242426</Color>
    <Color x:Key="Color.Neutral150">#2C2C2E</Color>
    <Color x:Key="Color.Neutral200">#3A3A3C</Color>
    <Color x:Key="Color.Neutral300">#48484A</Color>
    <Color x:Key="Color.Neutral400">#636366</Color>
    <Color x:Key="Color.Neutral500">#8E8E93</Color>
    <Color x:Key="Color.Neutral600">#AEAEB2</Color>
    <Color x:Key="Color.Neutral700">#D1D1D6</Color>
    <Color x:Key="Color.Neutral800">#E5E5EA</Color>
    <Color x:Key="Color.Neutral900">#F5F5F7</Color>

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentTop" Color="{StaticResource Color.AccentTop}" />
    <SolidColorBrush x:Key="Brush.AccentBottom" Color="{StaticResource Color.AccentBottom}" />
    <SolidColorBrush x:Key="Brush.Record" Color="{StaticResource Color.Record}" />
    <SolidColorBrush x:Key="Brush.RecordTop" Color="{StaticResource Color.RecordTop}" />
    <SolidColorBrush x:Key="Brush.RecordBottom" Color="{StaticResource Color.RecordBottom}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Label" Color="{StaticResource Color.Label}" />
    <SolidColorBrush x:Key="Brush.LabelSecondary" Color="{StaticResource Color.LabelSecondary}" />
    <SolidColorBrush x:Key="Brush.LabelTertiary" Color="{StaticResource Color.LabelTertiary}" />
    <SolidColorBrush x:Key="Brush.GlassTintTop" Color="{StaticResource Color.GlassTintTop}" />
    <SolidColorBrush x:Key="Brush.GlassTintBottom" Color="{StaticResource Color.GlassTintBottom}" />
    <SolidColorBrush x:Key="Brush.GlassWhite" Color="{StaticResource Color.GlassWhite}" />
    <SolidColorBrush x:Key="Brush.GlassSolid" Color="{StaticResource Color.GlassSolid}" />
    <SolidColorBrush x:Key="Brush.DarkGlassSolid" Color="{StaticResource Color.DarkGlassSolid}" />
    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Group" Color="{StaticResource Color.Group}" />
    <SolidColorBrush x:Key="Brush.Separator" Color="{StaticResource Color.Separator}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="{StaticResource Color.Pressed}" />
    <SolidColorBrush x:Key="Brush.Selected" Color="{StaticResource Color.Selected}" />
    <SolidColorBrush x:Key="Brush.EdgeHighlight" Color="{StaticResource Color.EdgeHighlight}" />
    <SolidColorBrush x:Key="Brush.EdgeFade" Color="{StaticResource Color.EdgeFade}" />
    <SolidColorBrush x:Key="Brush.EdgeDark" Color="{StaticResource Color.EdgeDark}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
    <SolidColorBrush x:Key="Brush.AccentSubtleDark" Color="{StaticResource Color.AccentSubtleDark}" />
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="{StaticResource Color.AccentSubtle}" />
    <SolidColorBrush x:Key="Brush.AccentSubtleHover" Color="{StaticResource Color.AccentSubtleHover}" />
    <SolidColorBrush x:Key="Brush.White" Color="{StaticResource Color.White}" />
    <SolidColorBrush x:Key="Brush.Black" Color="{StaticResource Color.Black}" />
    <SolidColorBrush x:Key="Brush.Transparent" Color="{StaticResource Color.Transparent}" />
    <SolidColorBrush x:Key="Brush.Sunken" Color="{StaticResource Color.Sunken}" />
    <SolidColorBrush x:Key="Brush.RecordBorder" Color="{StaticResource Color.RecordBorder}" />
    <SolidColorBrush x:Key="Brush.RecordGlassTop" Color="{StaticResource Color.RecordGlassTop}" />
    <SolidColorBrush x:Key="Brush.RecordGlassBottom" Color="{StaticResource Color.RecordGlassBottom}" />
    <SolidColorBrush x:Key="Brush.Dim" Color="{StaticResource Color.Dim}" />
    <SolidColorBrush x:Key="Brush.RimBlue" Color="{StaticResource Color.RimBlue}" />
    <SolidColorBrush x:Key="Brush.Neutral100" Color="{StaticResource Color.Neutral100}" />
    <SolidColorBrush x:Key="Brush.Neutral300" Color="{StaticResource Color.Neutral300}" />
    <SolidColorBrush x:Key="Brush.Neutral400" Color="{StaticResource Color.Neutral400}" />
    <SolidColorBrush x:Key="Brush.Neutral500" Color="{StaticResource Color.Neutral500}" />
    <SolidColorBrush x:Key="Brush.Neutral800" Color="{StaticResource Color.Neutral800}" />
    <SolidColorBrush x:Key="Brush.Neutral900" Color="{StaticResource Color.Neutral900}" />
    <LinearGradientBrush x:Key="Brush.GlassTint" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Color.GlassTintTop}" Offset="0" />
        <GradientStop Color="{StaticResource Color.GlassTintBottom}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.GlassRim" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Color.EdgeHighlight}" Offset="0" />
        <GradientStop Color="{StaticResource Color.EdgeFade}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.SelectedGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Color.Selected}" Offset="0" />
        <GradientStop Color="{StaticResource Color.Pressed}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.PrimaryAction" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Color.AccentTop}" Offset="0" />
        <GradientStop Color="{StaticResource Color.AccentBottom}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.RubySolid" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Color.RecordTop}" Offset="0" />
        <GradientStop Color="{StaticResource Color.RecordBottom}" Offset="1" />
    </LinearGradientBrush>

    <!-- Compatibility keys: keep callers on the same semantic palette. -->
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Neutral50}" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.Neutral100}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.Hover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.EdgeHighlight}" />
    <SolidColorBrush x:Key="Brush.WindowBackdrop" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.Label}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.LabelSecondary}" />
    <SolidColorBrush x:Key="Brush.OverlayBase" Color="{StaticResource Color.GlassSolid}" />
    <SolidColorBrush x:Key="Brush.OverlayBorder" Color="{StaticResource Color.EdgeHighlight}" />
    <SolidColorBrush x:Key="Brush.OverlayText" Color="{StaticResource Color.Label}" />
    <SolidColorBrush x:Key="Brush.OverlayTextDim" Color="{StaticResource Color.LabelSecondary}" />
    <SolidColorBrush x:Key="Brush.OverlayIcon" Color="{StaticResource Color.Label}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentText}" />
    <SolidColorBrush x:Key="Brush.DangerOnDark" Color="{StaticResource Color.RecordTop}" />

    <FontFamily x:Key="FontFamily.Body">Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="FontFamily.Display">Segoe UI Variable Display, Microsoft YaHei UI</FontFamily>
    <sys:Double x:Key="Font.Badge">11</sys:Double>
    <sys:Double x:Key="Font.Caption">12</sys:Double>
    <sys:Double x:Key="Font.Body">13</sys:Double>
    <sys:Double x:Key="Font.Title">15</sys:Double>
    <sys:Double x:Key="Font.Display">20</sys:Double>

    <CornerRadius x:Key="Radius.Key">5</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Button">8</CornerRadius>
    <CornerRadius x:Key="Radius.Menu">10</CornerRadius>
    <CornerRadius x:Key="Radius.Bar">12</CornerRadius>
    <CornerRadius x:Key="Radius.Card">14</CornerRadius>

    <DropShadowEffect x:Key="Shadow.Glass" BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.4" Color="{StaticResource Color.Black}" />
</ResourceDictionary>
