<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Recording.CountdownMask" Color="#8F1E1E20"/>
    <SolidColorBrush x:Key="Recording.Mask" Color="#851E1E20"/>
    <SolidColorBrush x:Key="Recording.BadgeFill" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="Recording.RingTrack" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="Recording.StopFill" Color="#B3FF453A"/>
    <CornerRadius x:Key="Recording.CountdownRadius">64</CornerRadius>
    <RadialGradientBrush x:Key="Recording.Beacon" GradientOrigin="0.34,0.27">
        <GradientStop Offset="0" Color="#FF8A80"/>
        <GradientStop Offset="0.55" Color="#FF453A"/>
        <GradientStop Offset="1" Color="#D83028"/>
    </RadialGradientBrush>
    <DropShadowEffect x:Key="Recording.BeaconGlow" Color="#FF453A" BlurRadius="8" ShadowDepth="0" Opacity="0.65"/>
    <Style x:Key="Recording.MeterBar" TargetType="Border">
        <Setter Property="Width" Value="2.5"/><Setter Property="Height" Value="3"/>
        <Setter Property="Margin" Value="0,0,2,0"/><Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource Brush.White}"/>
    </Style>
    <Style x:Key="Recording.Stop" TargetType="Button">
        <Setter Property="MinWidth" Value="34"/><Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="10,0"/><Setter Property="Margin" Value="2,0,0,0"/>
        <Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="{DynamicResource Recording.StopFill}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.White}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Face" CornerRadius="{DynamicResource Radius.Button}" Background="{TemplateBinding Background}"
                    BorderThickness="1,1,0,0" BorderBrush="{DynamicResource Brush.EdgeHighlight}">
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="{DynamicResource Brush.Record}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.8"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
